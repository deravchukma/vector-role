FROM {{ item.image }}

RUN if command -v apt-get >/dev/null; then \
      apt-get update && \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3 sudo systemd systemd-sysv ca-certificates && \
      apt-get clean && rm -rf /var/lib/apt/lists/*; \
    elif command -v dnf >/dev/null; then \
      dnf install -y python3 sudo systemd ca-certificates && dnf clean all; \
    fi
